# Database
MONGODB_URI=mongodb://localhost:27017/dropshipping-store
# or use MongoDB Atlas: mongodb+srv://<YOUR_USERNAME>:<YOUR_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/dropshipping-store

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Stripe Payment (get from https://stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Admin credentials (change these!)
ADMIN_EMAIL=admin@shopstore.com
ADMIN_PASSWORD=change-this-password

# Supplier API (optional - for automated product imports)
SUPPLIER_API_KEY=your_supplier_api_key_here
SUPPLIER_API_URL=https://api.yoursupplier.com
